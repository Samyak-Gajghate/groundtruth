# ---- LLM ----
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Auth provider: dev | clerk ----
# dev: built-in HS256 JWT (signup/login endpoints active)
# clerk: verify Clerk session tokens against CLERK_PUBLIC_KEY
AUTH_PROVIDER=dev
JWT_SECRET=please-rotate-me-and-make-it-long
JWT_TTL_MINUTES=1440
CLERK_SECRET_KEY=
CLERK_PUBLIC_KEY=

# ---- Billing provider: mock | stripe ----
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ---- Database ----
POSTGRES_USER=saas
POSTGRES_PASSWORD=saas
POSTGRES_DB=saas
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://saas:saas@postgres:5432/saas

# ---- App ----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3002
LOG_LEVEL=INFO

# ---- RAG ----
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RETRIEVE_TOP_K=5

# ---- Plan limits (per month per tenant) ----
PLAN_FREE_DOCS=20
PLAN_FREE_MESSAGES=200
PLAN_PRO_DOCS=500
PLAN_PRO_MESSAGES=10000
PLAN_ENTERPRISE_DOCS=10000
PLAN_ENTERPRISE_MESSAGES=200000

# ---- Frontend ----
NEXT_PUBLIC_API_BASE=http://localhost:8000
